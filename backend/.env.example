# Together.ai — get key at https://api.together.ai/
TOGETHER_API_KEY=your_together_api_key_here

# LLM
LLM_MODEL=meta-llama/Meta-Llama-3-8B-Instruct-Lite

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# RAG
TOP_K=5
CHUNK_SIZE_WORDS=600
CHUNK_OVERLAP_WORDS=75

# Paths (relative to backend/ — defaults usually fine)
# DATA_DIR=../data
# INDEX_DIR=rag/index

# Server
HOST=0.0.0.0
PORT=8000
